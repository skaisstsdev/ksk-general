# Ключ для чат-бота (src/app/api/chat/route.ts) — модель gpt-4o-mini.
OPENAI_API_KEY=

# Отправка заявок с форм (src/app/api/submit-form/route.ts).
RESEND_API_KEY=
# Куда падают заявки. Сначала можно поставить свою тестовую почту,
# потом переключить на pflege@ksk-farmos.de — без правки кода.
RESEND_TO=
# С какого адреса уходит письмо. Без подтверждённого в Resend домена
# (Settings → Domains → ksk-farmos.de) можно временно оставить пустым —
# тогда используется onboarding@resend.dev, тестовый адрес Resend,
# но он умеет слать только на почту, привязанную к самому аккаунту
# Resend. После подтверждения домена впиши сюда что-то вида
# "KSK Farmos <formular@ksk-farmos.de>".
RESEND_FROM=
