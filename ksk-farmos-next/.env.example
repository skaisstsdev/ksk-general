# Копия — в `.env.local`, который не попадает в git (см. .gitignore).

# Чат-виджет (src/app/api/chat/route.ts). Без ключа виджет отвечает
# фолбэком с телефоном — сайт не ломается, просто ИИ-ассистент молчит.
OPENAI_API_KEY=

# Приём заявок с форм через Resend (src/app/api/submit-form/route.ts).
# Без обоих ключей формы отвечают ошибкой — эти два обязательны.
RESEND_API_KEY=
RESEND_TO=pflege@ksk-farmos.de

# Адрес отправителя. Домен должен быть подтверждён в Resend (SPF/DKIM) —
# иначе письма уходят только на почту владельца аккаунта Resend, а не
# на реальные адреса получателей. Без переменной используется
# `onboarding@resend.dev` — тестовый адрес Resend, не для прод-трафика.
RESEND_FROM=
